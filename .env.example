# Copy to .env (local) and set the same variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# MongoDB connection string (includes credentials).
MONGODB_URI=

# Secret for SmartSell session cookies and OAuth state. Use a long random value
# (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=

# NextAuth (Google/GitHub sign-in only).
# AUTH_SECRET is read by Auth.js itself (not by SmartSell code) to encrypt its
# short-lived sign-in session. Use a long random value. Auth.js builds the
# Google/GitHub callback URLs from the site address, so no callback variable
# is needed; register <site>/api/auth/callback/google and .../github with the
# providers.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Only for testing Google/GitHub sign-in with a local production build
# (`next build && next start`). Not needed for `next dev` or on Vercel, which
# Auth.js trusts automatically. Leave it unset in Vercel.
# AUTH_TRUST_HOST=true

# Shopify app credentials from the Shopify Dev Dashboard.
# SHOPIFY_CLIENT_SECRET is also used to verify OAuth and webhook HMAC signatures.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Must exactly match an allowed redirect URL in the Dev Dashboard,
# e.g. http://localhost:3000/api/shopify/callback or https://<your-domain>/api/shopify/callback
SHOPIFY_REDIRECT_URI=

# Comma-separated scopes requested at install. Must also be enabled in the
# released app version; existing stores must reconnect to receive new scopes.
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,read_locations,read_customers

# Admin API version, YYYY-MM (quarterly). Defaults to 2026-07.
SHOPIFY_API_VERSION=

# Public HTTPS base URL Shopify sends webhooks to (no trailing path), e.g.
# https://your-app.vercel.app — or a tunnel URL during local development.
# Webhooks are registered at <this>/api/shopify/webhooks. localhost/http are refused.
SHOPIFY_WEBHOOK_BASE_URL=

# Random secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to the
# webhook recovery worker (/api/shopify/webhooks/process). Generate a long random value.
CRON_SECRET=

# ── eBay ────────────────────────────────────────────────────────────────────
# "sandbox" (default) or "production". Credentials are read from the matching
# EBAY_SANDBOX_* or EBAY_PRODUCTION_* variables below.
EBAY_ENVIRONMENT=sandbox

# Sandbox keyset from developer.ebay.com → Application Keys (Sandbox).
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_DEV_ID=
# RuName from User Tokens → "Get a Token from eBay via Your Application".
# Set its "Auth accepted URL" (and "Auth declined URL") to
# https://<your-domain>/api/ebay/callback. eBay requires HTTPS, so for local
# development use a tunnel URL or a Vercel preview.
EBAY_SANDBOX_RU_NAME=

# Production keyset (only when EBAY_ENVIRONMENT=production).
# EBAY_PRODUCTION_CLIENT_ID=
# EBAY_PRODUCTION_CLIENT_SECRET=
# EBAY_PRODUCTION_DEV_ID=
# EBAY_PRODUCTION_RU_NAME=

# Marketplace for new connections: EBAY_US (default), EBAY_GB, EBAY_DE, EBAY_AU or EBAY_CA.
EBAY_MARKETPLACE_ID=EBAY_US

# Optional: space- or comma-separated OAuth scopes. Defaults to api_scope,
# sell.inventory, sell.account, sell.fulfillment and commerce.identity.readonly.
# EBAY_SCOPES=

# Encrypts eBay OAuth tokens in MongoDB (AES-256-GCM). 32 random bytes,
# e.g. `openssl rand -base64 32`. Changing it requires sellers to reconnect eBay.
TOKEN_ENCRYPTION_KEY=

# Public address of the site, used in password-reset emails
# (e.g. https://your-app.vercel.app). Required in production; locally the
# address you opened is used.
APP_BASE_URL=

# Outgoing email (password reset). Any SMTP provider works; free with Gmail:
# turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, then use
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#   SMTP_PASS=<the 16-character app password>
# Leave empty to disable "Forgot password" (the page then says so).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
