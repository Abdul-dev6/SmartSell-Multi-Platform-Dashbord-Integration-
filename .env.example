# Copy to .env (local) and set the same variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# MongoDB connection string (includes credentials).
MONGODB_URI=

# Secret for SmartSell session cookies and OAuth state. Use a long random value
# (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=

# NextAuth (Google/GitHub sign-in only).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GOOGLE_CALLBACK_URL=

# Shopify app credentials from the Shopify Dev Dashboard.
# SHOPIFY_CLIENT_SECRET is also used to verify OAuth and webhook HMAC signatures.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Must exactly match an allowed redirect URL in the Dev Dashboard,
# e.g. http://localhost:3000/api/shopify/callback or https://<your-domain>/api/shopify/callback
SHOPIFY_REDIRECT_URI=

# Comma-separated scopes requested at install. Must also be enabled in the
# released app version; existing stores must reconnect to receive new scopes.
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,read_locations,read_customers

# Admin API version, YYYY-MM (quarterly). Defaults to 2026-07.
SHOPIFY_API_VERSION=

# Public HTTPS base URL Shopify sends webhooks to (no trailing path), e.g.
# https://your-app.vercel.app — or a tunnel URL during local development.
# Webhooks are registered at <this>/api/shopify/webhooks. localhost/http are refused.
SHOPIFY_WEBHOOK_BASE_URL=

# Random secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to the
# webhook recovery worker (/api/shopify/webhooks/process). Generate a long random value.
CRON_SECRET=
